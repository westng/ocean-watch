{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "candidate_git_sha", "repository", "runs"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate_git_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "repository": {"const": "westng/ocean-watch"},
    "runs": {
      "type": "object",
      "required": ["formal_evidence", "model_evidence", "canary_evidence", "marketplace_evidence", "rollback_evidence", "rollout_evidence"],
      "properties": {
        "formal_evidence": {"$ref": "#/$defs/formalRun"},
        "model_evidence": {"$ref": "#/$defs/externalRun"},
        "canary_evidence": {"$ref": "#/$defs/externalRun"},
        "marketplace_evidence": {"$ref": "#/$defs/externalRun"},
        "rollback_evidence": {"$ref": "#/$defs/externalRun"},
        "rollout_evidence": {"$ref": "#/$defs/externalRun"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["run_id", "workflow_path", "head_sha", "run_attempt"],
      "properties": {
        "run_id": {"type": "integer", "minimum": 1},
        "workflow_path": {"type": "string", "pattern": "^\\.github/workflows/.+\\.ya?ml$"},
        "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "run_attempt": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "formalRun": {
      "allOf": [
        {"$ref": "#/$defs/run"},
        {"properties": {"workflow_path": {"const": ".github/workflows/g5-evidence.yml"}}}
      ]
    },
    "externalRun": {
      "allOf": [
        {"$ref": "#/$defs/run"},
        {"properties": {"workflow_path": {"const": ".github/workflows/g5-external-evidence.yml"}}}
      ]
    }
  },
  "additionalProperties": false
}
