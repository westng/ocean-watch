{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "git_sha", "exceptions"],
  "properties": {
    "schema_version": {"const": 1},
    "git_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$", "not": {"const": "0000000000000000000000000000000000000000"}},
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "acceptance_id", "owner", "impact", "rollback_condition", "expires_at", "status", "blocking"],
        "properties": {
          "id": {"type": "string", "pattern": "^EX-[A-Z0-9-]+$"},
          "acceptance_id": {"type": "string", "pattern": "^AC-1(?:0[1-9]|1[0-9]|2[0-8])$"},
          "owner": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "rollback_condition": {"type": "string", "minLength": 1},
          "expires_at": {"type": "string", "format": "date-time"},
          "status": {"enum": ["open", "closed"]},
          "blocking": {"const": false}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
