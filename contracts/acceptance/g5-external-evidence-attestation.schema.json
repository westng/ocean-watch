{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/westng/ocean-watch/contracts/acceptance/g5-external-evidence-attestation.schema.json",
  "title": "Role-bound external G5 evidence attestation",
  "type": "object",
  "required": ["schema_version", "kind", "status", "source_key", "role", "repository", "git_sha", "candidate_identity", "candidate_identity_sha256", "producer_run", "source_run", "source_artifact_name", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "g5_external_evidence_attestation"},
    "status": {"const": "passed"},
    "source_key": {"enum": ["model_evidence", "canary_evidence", "marketplace_evidence", "rollback_evidence", "rollout_evidence"]},
    "role": {"enum": ["model", "canary", "marketplace", "rollback", "rollout"]},
    "repository": {"const": "westng/ocean-watch"},
    "git_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "candidate_identity": {"$ref": "candidate-identity.schema.json"},
    "candidate_identity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "producer_run": {"$ref": "#/$defs/run"},
    "source_run": {"$ref": "#/$defs/run"},
    "source_artifact_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["schema_version", "status", "run_id", "repository", "workflow_path", "head_sha", "run_attempt"],
      "properties": {
        "schema_version": {"const": 1},
        "status": {"const": "passed"},
        "run_id": {"type": "integer", "minimum": 1},
        "repository": {"const": "westng/ocean-watch"},
        "workflow_path": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$"},
        "head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "run_attempt": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
