{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocean-watch.local/contracts/skill-evals/schema.json",
  "type": "object",
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "case_set", "turns", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "case_set": {"type": "string"},
          "turns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["role", "content"],
              "properties": {
                "role": {"enum": ["user", "assistant"]},
                "content": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "expected": {
            "type": "object",
            "required": ["command"],
            "properties": {
              "skill": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
              "command": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
              "channel": {"enum": ["marketing", "qianchuan", "any"]},
              "forbidden_commands": {"type": "array", "items": {"type": "string"}},
              "presentation": {
                "type": "object",
                "properties": {
                  "required": {"type": "boolean"},
                  "verbatim_response": {"type": "boolean"},
                  "columns": {"type": "array", "items": {"type": "string"}},
                  "required_fragments": {"type": "array", "items": {"type": "string"}},
                  "fixture": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
