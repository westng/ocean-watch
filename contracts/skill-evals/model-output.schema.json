{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["tool_calls", "assistant_response", "presentation"],
  "properties": {
    "tool_calls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["skill", "command", "channel"],
        "properties": {
          "skill": {"enum": ["ads-plan-monitor", "qc-plan-monitor"]},
          "command": {"type": "string"},
          "channel": {"enum": ["marketing", "qianchuan", "any"]}
        },
        "additionalProperties": false
      }
    },
    "assistant_response": {"type": "string"},
    "presentation": {
      "type": "object",
      "required": ["required", "source", "rendered_markdown"],
      "properties": {
        "required": {"type": "boolean"},
        "source": {"enum": ["rendered_markdown", "none"]},
        "rendered_markdown": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
