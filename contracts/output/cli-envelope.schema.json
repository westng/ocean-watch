{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocean-watch.local/contracts/output/cli-envelope.schema.json",
  "title": "Ocean Watch CLI envelope",
  "type": "object",
  "required": [
    "ok"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "presentation": {
      "$ref": "presentation.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": false
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
